# systemd user service: TagMender keeps the folders your profiles watch processed.
# Needs no desktop session; runs at the lowest CPU and I/O priority.
#
#   tagmender setup                      # keys go to ~/.config/tagmender/*, mode 600
#   tagmender profiles set Inbox 'sources=[{"path": "/home/you/Music/Inbox", "watch": true}]' unattended=true
#   mkdir -p ~/.config/systemd/user
#   cp contrib/tagmender-watch.service ~/.config/systemd/user/
#   # installed from a package: ExecStart=/usr/bin/tagmender watch --nice
#   systemctl --user daemon-reload && systemctl --user enable --now tagmender-watch
#   journalctl --user -u tagmender-watch -f      (also ~/.local/state/tagmender/logs/tagmender.log)
#   loginctl enable-linger $USER                 # keep it running when you are logged out
[Unit]
Description=TagMender watched folders (identify, tag and organise new music)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 -u %h/Documents/Github/tagmender/tagmender.py watch --nice
Restart=on-failure
RestartSec=60
Nice=10
IOSchedulingClass=idle
# never let it write outside your home and media mounts by accident
ProtectSystem=strict
ReadWritePaths=%h /media /mnt
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
